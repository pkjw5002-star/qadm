# Neon — 앱 런타임용 Pooled connection (호스트에 -pooler 포함 권장)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require
# migrate deploy용 Direct connection (권장)
# DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# 32자 이상 랜덤 문자열
SESSION_PASSWORD=

# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# 아시아(서울) 버킷: qadm-29e97-asia-ne3 — docs/STORAGE_ASIA_MIGRATION.md
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 사진 업로드 (Vercel 배포 시 필수) — Firebase 콘솔 > 서비스 계정 > 비공개 키
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=  # 없으면 NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET 사용
